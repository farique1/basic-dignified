10 CLS
20 OPEN # 4,"S"
30 PRINT#4;"STREAM 4"
40 CLOSE # 4
50 LET a$="\{00}\{FF}"
60 PRINT "LITERAL BYTES ";CODE a$(1);",";CODE a$(2)
70 \{F5}"RAW PRINT TOKEN"
80 STOP
90 SAVE "STREAMS" LINE 10
100 SAVE "BLOCK" CODE 30000,16
110 VERIFY "BLOCK" CODE 30000,16
120 LOAD "BLOCK" CODE 30000,16
130 LOAD "PICTURE" SCREEN$
140 DIM b(3)
150 SAVE "ARRAY" DATA b()
160 LOAD "ARRAY" DATA b()
170 MERGE "EXTRA"
180 INPUT#0;LINE b$
190 LIST#2;10
200 LPRINT "PRINTER":LLIST
210 COPY
220 STOP
