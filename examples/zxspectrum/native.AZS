10 REM  SPECTRUM 1.6: BIN AND CHAINED STATEMENTS
20 CLS
30 LET mask=BIN 00000101:LET mask=mask+(BIN 10):PRINT "BIN ";mask
40 IF mask=7 THEN PRINT "CHAIN OK":PRINT "A:B"
50 OUT 254,BIN 00000001
60 PRINT "PRESS A KEY TO LIST":PAUSE 0
70 LIST 100
80 PRINT "PRESS A KEY TO RUN":PAUSE 0
90 RUN 100
100 PRINT "DONE"
110 STOP
