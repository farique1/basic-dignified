{
  "for next loop": {
    "prefix": "for-next",
    "description": "ZX-81 FOR/NEXT loop",
    "body": [
      "for ${1:index} = ${2:0} to ${3:10}",
      "\t${4:}",
      "next ${1:index}",
      "$0"
    ]
  },
  "print at": {
    "prefix": "print-at",
    "description": "Print at ZX-81 row and column",
    "body": ["print at ${1:0},${2:0}; ${3:}"]
  },
  "label loop": {
    "prefix": "loop-label",
    "description": "Labelled loop with GOTO",
    "body": [
      "{${1:loop}}",
      "${2:}",
      "goto {${1:loop}}"
    ]
  },
  "if then goto": {
    "prefix": "if-goto",
    "description": "Conditional branch to a label",
    "body": ["if ${1:condition} then goto {${2:label}}"]
  },
  "remx": {
    "prefix": "remx",
    "description": "REM line reserving bytes for machine code",
    "body": ["remx ${1:1},${2:100}", "$0"]
  },
  "remtags": {
    "prefix": "remtags",
    "description": "Basic Dignified remtags",
    "body": [
      "##BB:export_file=${1:}",
      "##BB:arguments=${2:}",
      "##BB:help=${3:}",
      "$0"
    ]
  }
}